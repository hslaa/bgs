{
  "name": "bgs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "icons": "python3 -I scripts/icons.py",
    "screenshots": "BGS_CONFIG_FILE=config.example.json npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
